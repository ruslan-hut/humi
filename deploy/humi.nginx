# /etc/nginx/sites-available/humi, symlinked into sites-enabled.
# Get the certificate first (certbot certonly --nginx -d humi.nomadus.net),
# or nginx -t fails on the missing files below. The certbot timer renews it.

limit_req_zone $binary_remote_addr zone=humi_ingest:1m rate=30r/m;

server {
    listen 80;
    listen [::]:80;
    server_name humi.nomadus.net;

    # Nothing is served over plain http; certbot answers its own challenge.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name humi.nomadus.net;

    ssl_certificate     /etc/letsencrypt/live/humi.nomadus.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/humi.nomadus.net/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 64k;

    # The nodes: their own bearer token, no basic auth.
    location = /api/v1/readings {
        limit_req zone=humi_ingest burst=5 nodelay;
        proxy_pass http://127.0.0.1:9820;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Dashboard and read API: basic auth until phase 5 (user auth) lands.
    location / {
        auth_basic "humi";
        auth_basic_user_file /etc/nginx/humi.htpasswd;

        proxy_pass http://127.0.0.1:9820;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
